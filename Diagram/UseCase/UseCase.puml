@startuml

!include ../theme.puml

title Use Case Diagram - Sistem Distribusi Ery Collection

left to right direction

actor "Admin\n(Pemilik Toko)" as Admin

rectangle "Sistem Distribusi Ery Collection" {
  usecase "Login" as UC_Login
  usecase "Logout" as UC_Logout
  usecase "Melihat Dashboard" as UC_Dashboard
  usecase "Kelola Data Produk" as UC_Produk
  usecase "Kelola Data Distribusi" as UC_Distribusi
  usecase "Menjalankan Analisis\nPrediksi C4.5" as UC_Predict
  usecase "Melihat Hasil\nAnalisis Prediksi" as UC_PredictView
  usecase "Melihat Laporan Distribusi" as UC_Report
  usecase "Mencetak Laporan Distribusi" as UC_ReportPrint

  UC_ReportPrint .> UC_Report : <<extend>>
}

Admin -- UC_Login
Admin -- UC_Logout
Admin -- UC_Dashboard
Admin -- UC_Produk
Admin -- UC_Distribusi
Admin -- UC_Predict
Admin -- UC_PredictView
Admin -- UC_Report

@enduml
